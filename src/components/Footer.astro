---
import {
  Globe,
  Mail,
  Phone,
  MapPin,
  ExternalLink,
  ArrowRight,
  ShieldCheck,
  Clock,
  Sparkles,
} from "lucide-astro";

const currentYear = new Date().getFullYear();

// Tópicos organizados para navegación rápida
const topics = [
  { title: "Tecnología", path: "/#technology-section" },
  { title: "Entretenimiento", path: "/#entertainment-section" },
  { title: "Deportes", path: "/#sports-section" },
  { title: "Misterio", path: "/#mistery-section" },
  { title: "Espectáculos", path: "/#show-section" },
  { title: "Ciencia", path: "/#science-section" },
  { title: "Salud", path: "/#health-section" },
  { title: "Economía", path: "/#economy-section" },
  { title: "Viajes", path: "/#travel-section" },
  { title: "Cultura", path: "/#culture-section" },
  { title: "Gastronomía", path: "/#gastronomy-section" },
];

// Enlaces rápidos institucionales y legales
const quickLinks = [
  { title: "Quiénes Somos", path: "/about" },
  { title: "Política de Privacidad", path: "/privacy" },
  { title: "Política de Cookies", path: "#" },
  { title: "Trabaja con Nosotros", path: "#" },
];

// Redes sociales oficiales con enlaces a homepages
const socialNetworks = [
  {
    name: "X (Twitter)",
    url: "https://x.com",
    iconSvg: `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="w-4 h-4"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg>`,
  },
  {
    name: "Facebook",
    url: "https://facebook.com",
    iconSvg: `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="w-4 h-4"><path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/></svg>`,
  },
  {
    name: "Instagram",
    url: "https://instagram.com",
    iconSvg: `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-4 h-4"><rect width="20" height="20" x="2" y="2" rx="5" ry="5"/><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"/><line x1="17.5" x2="17.51" y1="6.5" y2="6.5"/></svg>`,
  },
  {
    name: "YouTube",
    url: "https://youtube.com",
    iconSvg: `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="w-4 h-4"><path d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"/></svg>`,
  },
  {
    name: "LinkedIn",
    url: "https://linkedin.com",
    iconSvg: `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="w-4 h-4"><path d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.783 1.764-1.75 1.764zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z"/></svg>`,
  },
];
---

<footer
  class="w-full bg-primary text-secondary border-t border-quinary/30 relative overflow-hidden"
>
  <!-- Efecto sutil de iluminación en el fondo -->
  <div
    class="absolute -top-32 -left-32 w-80 h-80 rounded-full bg-tertiary/10 blur-3xl pointer-events-none"
  >
  </div>
  <div
    class="absolute -bottom-32 -right-32 w-80 h-80 rounded-full bg-quinary/20 blur-3xl pointer-events-none"
  >
  </div>

  <!-- Contenedor Principal -->
  <div
    class="max-w-7xl mx-auto px-5 sm:px-8 lg:px-12 pt-14 pb-10 relative z-10"
  >
    <div
      class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-12 gap-10 lg:gap-8 pb-12 border-b border-quinary/25"
    >
      <!-- Columna 1: Identidad del Sitio y Misión (Lg: 4 cols) -->
      <div class="lg:col-span-4 flex flex-col gap-5">
        <!-- Logo oficial idéntico al Header -->
        <a
          href="/"
          class="flex items-center gap-2.5 font-bold text-xl text-secondary hover:text-tertiary transition-colors group w-fit"
        >
          <div
            class="w-10 h-10 rounded-xl bg-linear-to-tr from-primary to-tertiary flex items-center justify-center text-white shadow-md shadow-indigo-500/20 group-hover:scale-105 transition-transform"
          >
            <Globe class="w-5 h-5 text-secondary" />
          </div>
          <span class="tracking-tight text-lg">
            El Vértice <span class="text-tertiary font-bold">Global</span>
          </span>
        </a>

        <p class="text-sm text-secondary/80 leading-relaxed font-normal">
          Periodismo digital independiente, análisis riguroso y cobertura en
          tiempo real de las noticias, tecnologías y tendencias que definen el
          rumbo del mundo actual.
        </p>

        <!-- Redes Sociales -->
        <div class="flex flex-col gap-2 pt-2">
          <span
            class="text-xs font-semibold uppercase tracking-wider text-tertiary"
          >
            Síguenos en Redes
          </span>
          <div class="flex items-center gap-2.5">
            {
              socialNetworks.map((social) => (
                <a
                  href={social.url}
                  target="_blank"
                  rel="noopener noreferrer"
                  aria-label={social.name}
                  class="w-9 h-9 rounded-lg bg-quinary/40 border border-quinary/40 flex items-center justify-center text-secondary/80 hover:text-white hover:bg-tertiary hover:border-tertiary hover:-translate-y-0.5 transition-all duration-200 shadow-xs"
                >
                  <Fragment set:html={social.iconSvg} />
                </a>
              ))
            }
          </div>
        </div>
      </div>

      <!-- Columna 2: Tópicos y Secciones de Noticias (Lg: 4 cols) -->
      <div class="lg:col-span-4 flex flex-col gap-4">
        <h3
          class="text-sm font-bold uppercase tracking-wider text-secondary flex items-center gap-2"
        >
          <Sparkles class="w-4 h-4 text-tertiary" />
          Tópicos y Secciones
        </h3>
        <p class="text-xs text-secondary/70">
          Explora la actualidad organizada por categorías especializadas:
        </p>

        <!-- Distribución equilibrada en 2 columnas legibles -->
        <div class="grid grid-cols-2 gap-x-4 gap-y-2.5 pt-1 text-sm">
          {
            topics.map((topic) => (
              <a
                href={topic.path}
                class="inline-flex items-center gap-1.5 text-secondary/75 hover:text-tertiary transition-colors group"
              >
                <span class="w-1.5 h-1.5 rounded-full bg-tertiary/60 group-hover:bg-tertiary group-hover:scale-125 transition-all" />
                <span class="truncate">{topic.title}</span>
              </a>
            ))
          }
        </div>
      </div>

      <!-- Columna 3: Información de Contacto y Sede Oficial (Lg: 4 cols) -->
      <div class="lg:col-span-4 flex flex-col gap-4">
        <h3
          class="text-sm font-bold uppercase tracking-wider text-secondary flex items-center gap-2"
        >
          <Phone class="w-4 h-4 text-tertiary" />
          Contacto y Redacción
        </h3>

        <ul class="flex flex-col gap-3 text-sm text-secondary/85">
          <!-- Número de contacto -->
          <li class="flex items-start gap-3 group">
            <div
              class="w-8 h-8 rounded-lg bg-quinary/30 border border-quinary/30 flex items-center justify-center shrink-0 mt-0.5 text-tertiary"
            >
              <Phone class="w-4 h-4" />
            </div>
            <div class="flex flex-col">
              <span class="text-xs text-secondary/60"
                >Línea Redacción Central:</span
              >
              <a
                href="tel:+18005558378"
                class="font-semibold text-secondary hover:text-tertiary transition-colors"
              >
                +1 (800) 555-VERTICE / +34 910 234 567
              </a>
            </div>
          </li>

          <!-- Correo electrónico -->
          <li class="flex items-start gap-3 group">
            <div
              class="w-8 h-8 rounded-lg bg-quinary/30 border border-quinary/30 flex items-center justify-center shrink-0 mt-0.5 text-tertiary"
            >
              <Mail class="w-4 h-4" />
            </div>
            <div class="flex flex-col">
              <span class="text-xs text-secondary/60"
                >Correo Oficial y Prensa:</span
              >
              <a
                href="mailto:redaccion@elverticeglobal.com"
                class="font-semibold text-secondary hover:text-tertiary transition-colors"
              >
                redaccion@elverticeglobal.com
              </a>
              <a
                href="mailto:contacto@elverticeglobal.com"
                class="text-xs text-secondary/70 hover:text-tertiary transition-colors"
              >
                contacto@elverticeglobal.com
              </a>
            </div>
          </li>

          <!-- Sitio Oficial -->
          <li class="flex items-start gap-3 group">
            <div
              class="w-8 h-8 rounded-lg bg-quinary/30 border border-quinary/30 flex items-center justify-center shrink-0 mt-0.5 text-tertiary"
            >
              <Globe class="w-4 h-4" />
            </div>
            <div class="flex flex-col">
              <span class="text-xs text-secondary/60">Portal Web Oficial:</span>
              <a
                href="https://www.elverticeglobal.com"
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex items-center gap-1 font-semibold text-tertiary hover:underline underline-offset-2"
              >
                <span>www.elverticeglobal.com</span>
                <ExternalLink class="w-3.5 h-3.5" />
              </a>
            </div>
          </li>

          <!-- Dirección / Ubicación -->
          <li class="flex items-start gap-3">
            <div
              class="w-8 h-8 rounded-lg bg-quinary/30 border border-quinary/30 flex items-center justify-center shrink-0 mt-0.5 text-tertiary"
            >
              <MapPin class="w-4 h-4" />
            </div>
            <div
              class="flex flex-col text-xs text-secondary/70 leading-relaxed"
            >
              <span class="font-semibold text-secondary"
                >Sede Internacional:</span
              >
              Av. de las Comunicaciones 450, Piso 10, Edificio Global Press, Ciudad
              Metropolitana.
            </div>
          </li>
        </ul>
      </div>
    </div>

    <!-- Barra Inferior: Copyright, Horario y Enlaces Legales -->
    <div
      class="pt-8 flex flex-col md:flex-row items-center justify-between gap-4 text-xs text-secondary/60"
    >
      <!-- Copyright y Marca -->
      <div
        class="flex flex-wrap items-center justify-center md:justify-start gap-2 text-center md:text-left"
      >
        <span>© {currentYear} <strong>El Vértice Global</strong>.</span>
        <span class="hidden sm:inline">•</span>
        <span>Todos los derechos reservados.</span>
        <span class="hidden sm:inline">•</span>
        <span class="inline-flex items-center gap-1 text-secondary/75">
          <Clock class="w-3 h-3 text-tertiary" /> Actualización continua 24/7
        </span>
      </div>

      <!-- Enlaces secundarios -->
      <nav
        class="flex flex-wrap items-center justify-center gap-x-4 gap-y-2 text-secondary/70"
      >
        {
          quickLinks.map((link) => (
            <a href={link.path} class="hover:text-tertiary transition-colors">
              {link.title}
            </a>
          ))
        }
      </nav>
    </div>
  </div>
</footer>
