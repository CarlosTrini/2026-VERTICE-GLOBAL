---
import type { CollectionEntry } from "astro:content";
import { Calendar, User, ArrowRight } from "lucide-astro";

interface Props {
    article: CollectionEntry<"news"> | any;
}

const { article } = Astro.props;

// Soporte flexible para CollectionEntry (article.data) u objeto directo
const data = article?.data ?? article ?? {};
const {
    title = "Sin título",
    description = "",
    pubDate,
    author = "Redacción",
    topic = "General",
    image,
    slug = article?.id || article?.slug || "#",
} = data;

// Formateo de fecha localizada (ej: 10 sep 2026)
const formattedDate = pubDate
    ? new Intl.DateTimeFormat("es-ES", {
          day: "2-digit",
          month: "2-digit",
          year: "numeric",
      }).format(new Date(pubDate))
    : "Reciente";

// Truncar descripción a un máximo estricto de 60 caracteres
const rawDesc = (description || "").trim();
const truncatedDescription =
    rawDesc.length > 60 ? `${rawDesc.slice(0, 100).trimEnd()}...` : rawDesc;

// Clase de tag según categoría definida en global.css
const normalizedTopic = (topic || "general").toLowerCase().trim();
const categoryTagClass = `${normalizedTopic}-tag`;

// Manejo de imagen con URL o fallback
const imageUrl = image?.startsWith("http")
    ? image
    : image
      ? image.startsWith("/")
          ? image
          : `/${image}`
      : "https://picsum.photos/seed/news/800/600";
---

<article
    class="w-full group relative h-full bg-secondary rounded-md overflow-hidden shadow-md hover:shadow-2xl hover:-translate-y-1.5 transition-all duration-300 border border-quinary/15"
>
    <!-- Contenedor de Imagen y Tag de Categoría -->
    <div class="w-full max-h-50 overflow-hidden bg-quinary/10">
        <img
            src={imageUrl}
            alt={title}
            loading="lazy"
            class="w-full h-full object-cover group-hover:scale-105 transition-all duration-500 ease-out opacity-80 group-hover:opacity-95"
        />

        <!-- Tag de Categoría -->
        <span
            class={`absolute top-3 left-3 text-xs md:text-[10px] lg:text-xs font-bold capitalize tracking-wider px-3 py-1 rounded-full shadow-md backdrop-blur-xs transition-transform duration-300 group-hover:scale-105 ${categoryTagClass}`}
        >
            {topic}
        </span>
    </div>

    <!-- Contenido de la Card -->
    <div class="w-full p-3 flex flex-col flex-1 justify-between gap-3">
        <!-- Metadatos: Día y Autor -->
        <div
            class="mb-1 flex flex-wrap items-center justify-between gap-2 text-xs font-semibold text-quinary"
        >
            <!-- Día con icono de calendario -->
            <span
                class="inline-flex items-center gap-1.5 text-primary font-bold"
                title={`Publicado: ${formattedDate}`}
            >
                <Calendar class="w-3.5 h-3.5 shrink-0 text-tertiary" />
                <time
                    datetime={pubDate
                        ? new Date(pubDate).toISOString()
                        : undefined}
                >
                    {formattedDate}
                </time>
            </span>

            <!-- Autor con icono de usuario -->
            <span
                class="inline-flex items-center gap-1.5 truncate max-w-32.5 text-primary"
                title={`Autor: ${author}`}
            >
                <User class="w-3.5 h-3.5 shrink-0 text-tertiary" />
                <span class="truncate italic font-bold">{author}</span>
            </span>
        </div>

        <div>
            <!-- Título de la nota -->
            <h3
                class="font-bold text-md leading-snug line-clamp-2 text-primary group-hover:text-quaternary transition-colors duration-200"
            >
                <a
                    title={title}
                    href={`/news/${slug}`}
                    class="hover:underline underline-offset-2 focus:outline-hidden italic text-sm"
                >
                    {title}
                </a>
            </h3>

            <!-- Descripción (máximo 60 caracteres) -->
            <p
                title={truncatedDescription}
                class="text-sm text-primary leading-relaxed line-clamp-1 font-normal"
            >
                {truncatedDescription}
            </p>
        </div>

        <!-- Pie de Card: Acción / Enlace a la nota -->
        <div
            class="pt-3 border-t border-quinary/10 flex items-center justify-between text-xs font-bold text-tertiary group-hover:text-quaternary transition-colors duration-200"
        >
            <a
                href={`/news/${slug}`}
                class="text-4 inline-flex items-center gap-1.5 group-hover:translate-x-1 transition-transform duration-200"
            >
                <span>Leer nota</span>
                <ArrowRight class="w-3.5 h-3.5" />
            </a>
        </div>
    </div>
</article>
