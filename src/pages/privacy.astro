---
import MainLayout from "../layouts/MainLayout.astro";
import {
    ArrowLeft,
    ShieldCheck,
    Lock,
    Eye,
    FileText,
    CheckCircle2,
    Mail,
    Globe,
    Scale,
    Clock,
} from "lucide-astro";
---

<MainLayout
    title="Políticas de Privacidad | El Vértice Global"
    description="Conoce nuestras políticas de privacidad, tratamiento de datos personales y compromiso con la transparencia en El Vértice Global."
>
    <!-- BARRA SUPERIOR DE NAVEGACIÓN Y REGRESO -->
    <div class="bg-primary border-b border-quinary/30 py-3 section-padding">
        <div class="max-w-5xl mx-auto flex items-center justify-between gap-4">
            <a
                href="/"
                class="inline-flex items-center gap-2 px-4 py-2 rounded-xl bg-quinary/40 hover:bg-tertiary text-secondary transition-all duration-300 font-semibold text-xs md:text-sm border border-quinary/50 hover:border-tertiary group"
            >
                <ArrowLeft
                    class="w-4 h-4 group-hover:-translate-x-1 transition-transform"
                />
                <span>Volver al Inicio</span>
            </a>

            <div class="flex items-center gap-2 text-xs text-secondary/60">
                <span>Inicio</span>
                <span>/</span>
                <span>Legales</span>
                <span>/</span>
                <span class="text-tertiary font-medium">Privacidad</span>
            </div>
        </div>
    </div>

    <!-- HERO PRINCIPAL DE PRIVACIDAD -->
    <header
        class="relative overflow-hidden bg-linear-to-tr from-primary to-quinary text-secondary py-12 md:py-16 border-b border-secondary/10"
    >
        <!-- Luces ambientales de fondo -->
        <div
            class="pointer-events-none absolute -top-32 -left-32 w-96 h-96 rounded-full blur-[120px] opacity-20 bg-tertiary"
        >
        </div>
        <div
            class="pointer-events-none absolute -bottom-32 right-0 w-96 h-96 rounded-full blur-[120px] opacity-25 bg-quinary"
        >
        </div>

        <div class="relative max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
            <div
                class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-white/5 border border-white/10 text-xs text-secondary backdrop-blur-sm mb-4"
            >
                <ShieldCheck class="w-4 h-4 text-tertiary" />
                <span class="font-bold tracking-wide uppercase"
                    >Aviso Legal & Transparencia</span
                >
            </div>

            <h1
                class="text-3xl sm:text-4xl md:text-5xl font-black text-white tracking-tight mb-4 leading-tight"
            >
                Políticas de <span class="text-tertiary">Privacidad</span>
            </h1>

            <p
                class="text-base sm:text-lg text-secondary/80 max-w-3xl leading-relaxed mb-6"
            >
                En <strong>El Vértice Global</strong> valoramos profundamente la confianza
                de nuestros lectores. Aquí te explicamos con claridad y transparencia
                cómo tratamos, protegemos y gestionamos tu información personal.
            </p>

            <div
                class="flex flex-wrap items-center gap-4 text-xs text-secondary/70 pt-2 border-t border-white/10"
            >
                <span class="flex items-center gap-1.5">
                    <Clock class="w-3.5 h-3.5 text-tertiary" />
                    Última actualización: Septiembre de 2026
                </span>
                <span class="hidden sm:inline">•</span>
                <span class="flex items-center gap-1.5">
                    <Globe class="w-3.5 h-3.5 text-emerald-400" />
                    Ámbito de aplicación: Internacional / RGPD
                </span>
            </div>
        </div>
    </header>

    <!-- CUERPO DE LAS POLÍTICAS DE PRIVACIDAD -->
    <section class="section-padding bg-secondary py-12 md:py-16">
        <div class="max-w-5xl mx-auto space-y-8">
            <!-- Tarjeta 1: Compromiso General -->
            <article
                class="bg-primary text-secondary rounded-2xl p-6 sm:p-8 md:p-10 shadow-lg border border-quinary/30 space-y-4"
            >
                <div
                    class="flex items-center gap-3 text-tertiary font-bold text-lg"
                >
                    <div
                        class="w-10 h-10 rounded-xl bg-tertiary/10 border border-tertiary/20 flex items-center justify-center shrink-0"
                    >
                        <FileText class="w-5 h-5 text-tertiary" />
                    </div>
                    <h2>1. Identidad y Compromiso de El Vértice Global</h2>
                </div>
                <p
                    class="text-secondary/80 text-sm sm:text-base leading-relaxed"
                >
                    <strong>El Vértice Global</strong> es un medio de comunicación
                    y periodismo digital independiente dedicado a la divulgación informativa
                    y análisis de coyuntura mundial. Nos comprometemos a garantizar
                    que los datos de navegación e interacciones de cada usuario se
                    recopilen bajo los principios de licitud, lealtad, proporcionalidad
                    y estricta confidencialidad.
                </p>
            </article>

            <!-- Tarjeta 2: Información Recopilada -->
            <article
                class="bg-primary text-secondary rounded-2xl p-6 sm:p-8 md:p-10 shadow-lg border border-quinary/30 space-y-4"
            >
                <div
                    class="flex items-center gap-3 text-tertiary font-bold text-lg"
                >
                    <div
                        class="w-10 h-10 rounded-xl bg-tertiary/10 border border-tertiary/20 flex items-center justify-center shrink-0"
                    >
                        <Eye class="w-5 h-5 text-tertiary" />
                    </div>
                    <h2>2. Datos que Recopilamos</h2>
                </div>
                <p
                    class="text-secondary/80 text-sm sm:text-base leading-relaxed"
                >
                    Recopilamos únicamente la información indispensable para
                    brindarte una navegación fluida y los servicios informativos
                    que solicites voluntariamente:
                </p>
                <ul
                    class="space-y-3 pt-2 text-sm sm:text-base text-secondary/85"
                >
                    <li class="flex items-start gap-3">
                        <CheckCircle2
                            class="w-5 h-5 text-tertiary shrink-0 mt-0.5"
                        />
                        <span
                            ><strong>Suscripción a Newsletter:</strong> Únicamente
                            tu dirección de correo electrónico cuando decides recibir
                            nuestros boletines diarios o resúmenes semanales.</span
                        >
                    </li>
                    <li class="flex items-start gap-3">
                        <CheckCircle2
                            class="w-5 h-5 text-tertiary shrink-0 mt-0.5"
                        />
                        <span
                            ><strong>Datos técnicos de navegación:</strong> Métricas
                            agregadas y anónimas como tipo de navegador, sistema operativo
                            y páginas visitadas con el fin de optimizar el rendimiento
                            y la velocidad de carga de la plataforma.</span
                        >
                    </li>
                    <li class="flex items-start gap-3">
                        <CheckCircle2
                            class="w-5 h-5 text-tertiary shrink-0 mt-0.5"
                        />
                        <span
                            ><strong
                                >Comentarios y consultas de redacción:</strong
                            > Nombre y correo de contacto proporcionados al enviar
                            un mensaje a nuestra redacción o solicitar correcciones
                            informativas.</span
                        >
                    </li>
                </ul>
            </article>

            <!-- Tarjeta 3: Finalidad del Tratamiento -->
            <article
                class="bg-primary text-secondary rounded-2xl p-6 sm:p-8 md:p-10 shadow-lg border border-quinary/30 space-y-4"
            >
                <div
                    class="flex items-center gap-3 text-tertiary font-bold text-lg"
                >
                    <div
                        class="w-10 h-10 rounded-xl bg-tertiary/10 border border-tertiary/20 flex items-center justify-center shrink-0"
                    >
                        <Scale class="w-5 h-5 text-tertiary" />
                    </div>
                    <h2>3. Finalidad del Tratamiento de los Datos</h2>
                </div>
                <p
                    class="text-secondary/80 text-sm sm:text-base leading-relaxed"
                >
                    Los datos recabados son tratados exclusivamente para los
                    siguientes propósitos legítimos:
                </p>
                <div class="grid grid-cols-1 md:grid-cols-2 gap-4 pt-2">
                    <div
                        class="p-4 rounded-xl bg-quinary/20 border border-quinary/30"
                    >
                        <h3 class="font-bold text-white text-sm mb-1">
                            Distribución de Contenido
                        </h3>
                        <p class="text-xs text-secondary/70 leading-relaxed">
                            Envío de noticias destacadas, coberturas de última
                            hora y boletines editoriales previa solicitud.
                        </p>
                    </div>
                    <div
                        class="p-4 rounded-xl bg-quinary/20 border border-quinary/30"
                    >
                        <h3 class="font-bold text-white text-sm mb-1">
                            Mejora de la Experiencia
                        </h3>
                        <p class="text-xs text-secondary/70 leading-relaxed">
                            Detección de errores técnicos, optimización de
                            diseño responsive y tiempos de respuesta del portal.
                        </p>
                    </div>
                    <div
                        class="p-4 rounded-xl bg-quinary/20 border border-quinary/30"
                    >
                        <h3 class="font-bold text-white text-sm mb-1">
                            Atención al Lector
                        </h3>
                        <p class="text-xs text-secondary/70 leading-relaxed">
                            Respuesta oportuna a solicitudes de derecho de
                            réplica, sugerencias o dudas ciudadanas.
                        </p>
                    </div>
                    <div
                        class="p-4 rounded-xl bg-quinary/20 border border-quinary/30"
                    >
                        <h3 class="font-bold text-white text-sm mb-1">
                            Seguridad del Sitio
                        </h3>
                        <p class="text-xs text-secondary/70 leading-relaxed">
                            Prevención de ataques informáticos, spam
                            automatizado y uso fraudulento de nuestros
                            formularios.
                        </p>
                    </div>
                </div>
            </article>

            <!-- Tarjeta 4: No Venta ni Cesión de Datos -->
            <article
                class="bg-primary text-secondary rounded-2xl p-6 sm:p-8 md:p-10 shadow-lg border border-quinary/30 space-y-4"
            >
                <div
                    class="flex items-center gap-3 text-tertiary font-bold text-lg"
                >
                    <div
                        class="w-10 h-10 rounded-xl bg-tertiary/10 border border-tertiary/20 flex items-center justify-center shrink-0"
                    >
                        <Lock class="w-5 h-5 text-tertiary" />
                    </div>
                    <h2>4. No Comercialización ni Cesión a Terceros</h2>
                </div>
                <div
                    class="p-4 rounded-xl bg-quinary/30 border-l-4 border-tertiary text-secondary/90 text-sm leading-relaxed"
                >
                    <strong>Garantía Estricta:</strong> En <strong
                        >El Vértice Global</strong
                    > jamás vendemos, alquilamos ni transferimos tus datos personales
                    a empresas de mercadotecnia, agencias de publicidad externa ni
                    terceros para fines comerciales ajenos a nuestro medio.
                </div>
                <p
                    class="text-secondary/80 text-sm sm:text-base leading-relaxed"
                >
                    Únicamente compartiremos datos cuando sea estrictamente
                    requerido por mandato judicial o regulatorio conforme a las
                    leyes vigentes de protección de datos personales.
                </p>
            </article>

            <!-- Tarjeta 5: Cookies y Tecnologías -->
            <article
                class="bg-primary text-secondary rounded-2xl p-6 sm:p-8 md:p-10 shadow-lg border border-quinary/30 space-y-4"
            >
                <div
                    class="flex items-center gap-3 text-tertiary font-bold text-lg"
                >
                    <div
                        class="w-10 h-10 rounded-xl bg-tertiary/10 border border-tertiary/20 flex items-center justify-center shrink-0"
                    >
                        <Globe class="w-5 h-5 text-tertiary" />
                    </div>
                    <h2>5. Uso de Cookies</h2>
                </div>
                <p
                    class="text-secondary/80 text-sm sm:text-base leading-relaxed"
                >
                    Nuestro portal web utiliza cookies técnicas para permitir la
                    navegación fluida y cookies analíticas de carácter anónimo.
                    Puedes desactivar o configurar las cookies en cualquier
                    momento a través del panel de ajustes de tu navegador web
                    sin que ello impida la lectura general de las noticias.
                </p>
            </article>

            <!-- Tarjeta 6: Derechos ARCO y Contacto -->
            <article
                class="bg-primary text-secondary rounded-2xl p-6 sm:p-8 md:p-10 shadow-lg border border-quinary/30 space-y-4"
            >
                <div
                    class="flex items-center gap-3 text-tertiary font-bold text-lg"
                >
                    <div
                        class="w-10 h-10 rounded-xl bg-tertiary/10 border border-tertiary/20 flex items-center justify-center shrink-0"
                    >
                        <Mail class="w-5 h-5 text-tertiary" />
                    </div>
                    <h2>6. Ejercicio de tus Derechos y Contacto</h2>
                </div>
                <p
                    class="text-secondary/80 text-sm sm:text-base leading-relaxed"
                >
                    Como titular de tus datos, puedes ejercer en cualquier
                    momento tus derechos de Acceso, Rectificación, Cancelación,
                    Oposición y Limitación del tratamiento (Derechos ARCO), así
                    como darte de baja de nuestras comunicaciones por correo de
                    forma inmediata:
                </p>
                <div
                    class="bg-quinary/30 rounded-xl p-5 border border-quinary/40 flex flex-col sm:flex-row sm:items-center justify-between gap-4"
                >
                    <div>
                        <span
                            class="text-xs text-secondary/60 uppercase tracking-wider block"
                            >Canal Oficial de Privacidad</span
                        >
                        <a
                            href="mailto:redaccion@elverticeglobal.com"
                            class="text-tertiary font-bold text-base hover:underline"
                        >
                            redaccion@elverticeglobal.com
                        </a>
                        <p class="text-xs text-secondary/70 mt-1">
                            Atención a solicitudes en un plazo máximo de 48
                            horas hábiles.
                        </p>
                    </div>
                    <a
                        href="mailto:redaccion@elverticeglobal.com?subject=Solicitud%20de%20Privacidad%20y%20Derechos%20ARCO"
                        class="px-4 py-2.5 rounded-xl bg-tertiary text-primary hover:bg-quaternary hover:text-white transition-colors duration-300 font-bold text-xs uppercase tracking-wider text-center shrink-0"
                    >
                        Enviar Solicitud
                    </a>
                </div>
            </article>

            <!-- CTA FINAL DE REGRESO -->
            <div
                class="flex flex-col sm:flex-row items-center justify-between gap-4 pt-6 pb-2"
            >
                <a
                    href="/"
                    class="inline-flex items-center justify-center gap-2 px-6 py-3 rounded-2xl bg-primary text-secondary hover:bg-tertiary transition-all duration-300 font-bold text-sm shadow-md border border-quinary/40 group w-full sm:w-auto"
                >
                    <ArrowLeft
                        class="w-4 h-4 group-hover:-translate-x-1 transition-transform text-tertiary group-hover:text-secondary"
                    />
                    <span>Regresar a la Portada Principal</span>
                </a>

                <span
                    class="text-xs text-primary/60 italic text-center sm:text-right"
                >
                    El Vértice Global &bull; Periodismo independiente y
                    transparente
                </span>
            </div>
        </div>
    </section>
</MainLayout>
